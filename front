<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Service Desk Portal — ООО «РТК ИТ»</title>
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="https://cloudflare.com">
</head>
<body>
    <div class="container">
        <!-- Шапка -->
        <header>
            <div class="logo">
                <i class="fa-solid fa-headset"></i> 
                <span>ООО «РТК ИТ»</span>
            </div>
            <h1>Система учёта и маршрутизации заявок технической поддержки</h1>
            <p class="subtitle">Внутренний веб-модуль (Service Desk Portal) — Client-Side MVP v1.0</p>
        </header>

        <!-- Статус локального хранилища -->
        <section class="status-section">
            <div id="storage-status" class="status-badge loading">
                <i class="fa-solid fa-spinner fa-spin"></i> Инициализация локальной БД...
            </div>
        </section>

        <!-- Имитация функционала MVP (Интерактивная заглушка) -->
        <section class="demo-section">
            <h2><i class="fa-solid fa-ticket"></i> Быстрое тестирование MVP</h2>
            <div class="demo-actions">
                <button id="btn-create-ticket" class="btn">
                    <i class="fa-solid fa-plus"></i> Создать тестовую заявку (Имитация)
                </button>
                <p id="ticket-info">Заявок в системе: <strong id="ticket-count">0</strong></p>
            </div>
        </section>

        <!-- Состав команды -->
        <section class="team-section">
            <h2><i class="fa-solid fa-users"></i> Команда разработки</h2>
            <div class="team-grid">
                <div class="team-card">
                    <div class="avatar"><i class="fa-solid fa-user-gear"></i></div>
                    <h3>Иванов Иван</h3>
                    <p class="role">Team Lead / Аналитик</p>
                </div>
                <div class="team-card">
                    <div class="avatar"><i class="fa-solid fa-laptop-code"></i></div>
                    <h3>Сидоров Сидор</h3>
                    <p class="role">Frontend-разработчик</p>
                </div>
                <div class="team-card">
                    <div class="avatar"><i class="fa-solid fa-server"></i></div>
                    <h3>Алексеев Алексей</h3>
                    <p class="role">QA / DevOps-инженер</p>
                </div>
            </div>
        </section>
    </div>

    <script src="script.js"></script>
</body>
</html>
