<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Service Desk Portal — ООО «РТК ИТ»</title>
    <!-- Локальное подключение стилей, файлы лежат в одной папке -->
    <link rel="stylesheet" href="style.css">
    <!-- Подключение иконок через CDN -->
    <link rel="stylesheet" href="https://cloudflare.com">
</head>
<body>
    <div class="container">
        <!-- Шапка -->
        <header>
            <div class="logo">
                <i class="fa-solid fa-headset"></i> 
                <span>ООО «РТК ИТ»</span>
            </div>
            <h1>Система учёта и маршрутизации заявок технической поддержки</h1>
            <p class="subtitle">Внутренний веб-модуль (Service Desk Portal) — Local MVP v1.0</p>
        </header>

        <!-- Статус локальной системы хранения -->
        <section class="status-section">
            <div id="storage-status" class="status-badge online">
                <i class="fa-solid fa-database"></i> Локальная БД: Активна (Браузерное хранилище)
            </div>
        </section>

        <!-- Функционал создания заявок (MVP) -->
        <section class="demo-section">
            <h2><i class="fa-solid fa-ticket"></i> Панель оператора Service Desk</h2>
            <div class="demo-actions">
                <button id="btn-create-ticket" class="btn">
                    <i class="fa-solid fa-plus"></i> Создать тестовую заявку
                </button>
                <p id="ticket-info">Всего обращений в системе: <strong id="ticket-count">0</strong></p>
            </div>
        </section>

        <!-- Список участников команды -->
        <section class="team-section">
            <h2><i class="fa-solid fa-users"></i> Команда разработки</h2>
            <div class="team-grid">
                <div class="team-card">
                    <div class="avatar"><i class="fa-solid fa-user-gear"></i></div>
                    <h3>Иванов Иван</h3>
                    <p class="role">Team Lead / Аналитик</p>
                </div>
                <div class="team-card">
                    <div class="avatar"><i class="fa-solid fa-laptop-code"></i></div>
                    <h3>Сидоров Сидор</h3>
                    <p class="role">Frontend-разработчик</p>
                </div>
                <div class="team-card">
                    <div class="avatar"><i class="fa-solid fa-vial"></i></div>
                    <h3>Алексеев Алексей</h3>
                    <p class="role">QA-инженер / Тестировщик</p>
                </div>
            </div>
        </section>
    </div>

    <!-- Подключение скрипта -->
    <script src="script.js"></script>
</body>
</html>
